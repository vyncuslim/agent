# MCP gateway authentication. Required in production.
MCP_API_KEY=replace-with-a-long-random-secret

# Vynalth AI Search (your own search engine)
VYNALTH_SEARCH_BASE_URL=https://search.vynalthai.com
VYNALTH_SEARCH_TIMEOUT_MS=12000

# Supabase REST API. Use a dedicated/restricted key when possible.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY=replace-with-server-side-key

# Comma-separated allowlists. Empty = deny all Supabase table/RPC access.
SUPABASE_ALLOWED_TABLES=profiles,posts,support_tickets,feedback
SUPABASE_ALLOWED_RPCS=

# Destructive database operations stay disabled unless explicitly enabled.
MCP_ALLOW_DESTRUCTIVE=false
MCP_ALLOW_MASS_MUTATION=false

# Limits
MCP_MAX_SEARCH_RESULTS=10
MCP_MAX_DB_ROWS=100
MCP_MAX_FETCH_BYTES=400000
