# MCP gateway authentication. Required in production.
MCP_GATEWAY_TOKEN=replace-with-a-long-random-secret

# Vynalth AI Search (your own search engine)
VYNALTH_SEARCH_BASE_URL=https://search.vynalthai.com
VYNALTH_SEARCH_TIMEOUT_MS=12000

# Supabase Data API. Prefer a dedicated/restricted server-side key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-server-side-key

# Comma-separated allowlist. Empty = deny all Supabase table access.
SUPABASE_ALLOWED_TABLES=profiles,posts,support_tickets,feedback,partnership_inquiries

# Business tool table names. Each table must also be present in SUPABASE_ALLOWED_TABLES.
SUPABASE_SUPPORT_TABLE=support_tickets
SUPABASE_FEEDBACK_TABLE=feedback
SUPABASE_PARTNERSHIP_TABLE=partnership_inquiries

# Limits
MCP_MAX_SEARCH_RESULTS=10
MCP_MAX_DB_ROWS=100
