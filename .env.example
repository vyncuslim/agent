# MCP gateway authentication. Required in production.
MCP_GATEWAY_TOKEN=replace-with-a-long-random-secret

# Vynalth AI Search (your own search engine)
VYNALTH_SEARCH_BASE_URL=https://search.vynalthai.com
VYNALTH_SEARCH_TIMEOUT_MS=12000

# Supabase. Prefer a publishable key with RLS for read-only public/user-scoped data.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-publishable-or-restricted-server-key

# Comma-separated allowlist. Empty = deny all Supabase table access.
SUPABASE_ALLOWED_TABLES=profiles,posts,support_tickets,feedback
SUPABASE_ALLOWED_RPCS=

# Limits
MCP_MAX_SEARCH_RESULTS=10
MCP_MAX_DB_ROWS=100
MCP_MAX_FETCH_BYTES=400000
